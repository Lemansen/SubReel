<Application x:Class="SubReel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SubReel"
             xmlns:vm="clr-namespace:SubReel.Presentation.ViewModels.Pages"
             xmlns:views="clr-namespace:SubReel.Presentation.View.Pages"
             StartupUri="/Presentation/View/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:InverseBoolConverter x:Key="InverseBoolConverter" />

            <DataTemplate DataType="{x:Type vm:BuildsViewModel}">
                <views:BuildsPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:NewsViewModel}">
                <views:NewsPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CommunityViewModel}">
                <views:CommunityPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CreateBuildViewModel}">
                <views:CreateBuildPage />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
