<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <PublishTrimmed>false</PublishTrimmed>

    <ApplicationIcon>assets\SubReel.ico</ApplicationIcon>
  </PropertyGroup>

    <ItemGroup>
      <None Remove="assets\SubReel.ico" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="assets\SubReel.ico" />
    </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="Costura.Fody" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubReel.Launcher.Core\SubReel.Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\Launcher\" />
    <Folder Include="Models\News\" />
    <Folder Include="Presentation\View\Pages\" />
    <Folder Include="Presentation\View\Components\" />
    <Folder Include="Properties\" />
    <Folder Include="App\" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml" />
  </ItemGroup>

<ItemGroup>
  <Content Include="assets\SubReel.ico">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

</Project>
